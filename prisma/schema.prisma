generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Invite {
  id         String    @id @default(cuid())
  templateId String    @default("template-01")
  religion   String // "islamic" | "christian" | "hindu"
  data       Json // { groomName, brideName, date, time, venue, venueCity, colorPresetId, photoUrl, audioUrl, mapsUrl, showPetals, eventLabel, heroSubtitle, closingLine, footerBlessing }
  whatsapp    String?
  contactName String? // first name only, captured on the pre-builder quick-capture screen
  status      String    @default("draft") // draft | paid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  paidAt     DateTime?

  // Set when payment succeeds — the gateway's order id and the amount actually paid.
  orderId         String? @unique
  amountPaidPaise Int?

  // Abandoned-cart WhatsApp reminder — set once sent, so it never repeats.
  reminderSentAt DateTime?

  // Paid add-ons, chosen in the editor before checkout
  rsvpEnabled Boolean @default(false)
  songEnabled Boolean @default(false)

  // Private link the customer uses to see who RSVP'd
  rsvpDashboardToken String? @unique

  // Single-use shareable preview link
  previewShareToken    String?   @unique
  previewShareViewedAt DateTime?

  rsvps RsvpResponse[]

  @@index([status])
  @@index([whatsapp])
}

// One row per render of the quick-capture screen — the "Style Selected" stage
// of the funnel, logged before any Invite row exists (that only happens once
// the customer submits their WhatsApp number).
model StyleView {
  id         String   @id @default(cuid())
  religion   String
  templateId String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model RsvpResponse {
  id         String   @id @default(cuid())
  inviteId   String
  invite     Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  guestName  String
  attending  Boolean
  guestCount Int      @default(1)
  message    String?
  createdAt  DateTime @default(now())

  @@index([inviteId])
}
