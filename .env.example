# Postgres connection string (e.g. from Supabase, Neon, or Vercel Postgres).
# Required for the /templates invite builder to read/write drafts.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Vercel Blob — used to store the one invite photo per draft.
# Create via: Vercel dashboard -> Storage -> Blob -> Create Store -> copy token.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# Razorpay — unused (site runs on Cashfree, see below). Left for reference only.
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="xxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_WEBHOOK_SECRET="xxx"

# Cashfree — the live payment gateway for /templates checkout, embedded as a
# JS SDK modal (see lib/templates/cashfree.ts). Get keys from the Cashfree
# dashboard -> Developers -> API Keys. Set CASHFREE_ENV to "TEST" while
# developing; "PRODUCTION" charges real money.
CASHFREE_APP_ID="xxx"
CASHFREE_SECRET_KEY="xxx"
CASHFREE_ENV="TEST"
NEXT_PUBLIC_CASHFREE_ENV="TEST"
CASHFREE_WEBHOOK_SECRET="xxx"

# PayU — unused (site runs on Cashfree, see above). Left for reference only.
PAYU_KEY="xxx"
PAYU_SALT="xxx"
PAYU_ENV="TEST"

# Base price for a paid invite unlock, in paise (INR). 75900 = ₹759 (discounted from ₹1599).
INVITE_PRICE_PAISE="75900"
INVITE_LIST_PRICE_PAISE="159900"
# RSVP form + private guest dashboard add-on. 50000 = ₹500.
RSVP_ADDON_PRICE_PAISE="50000"
# Custom uploaded song add-on. 5900 = ₹59.
SONG_ADDON_PRICE_PAISE="5900"

# Password for /templates/admin (abandoned-cart list). Any string works.
ADMIN_PASSWORD="xxx"

# Shared secret the abandoned-cart cron caller must send as
# `Authorization: Bearer <value>` — must match the GitHub Actions repo
# secret of the same name (see .github/workflows/abandoned-cart-cron.yml).
CRON_SECRET="xxx"

# WhatsApp Cloud API (Meta) — optional. Until all three are set, abandoned-cart
# reminders safely no-op and /templates/admin's manual "Message on WhatsApp"
# button is the fallback. Requires a WhatsApp Business Platform account, a
# verified sending number, and an approved message template.
WHATSAPP_ACCESS_TOKEN="xxx"
WHATSAPP_PHONE_NUMBER_ID="xxx"
WHATSAPP_TEMPLATE_NAME="xxx"
WHATSAPP_TEMPLATE_LANG="en"

# Meta Pixel — site-wide client-side tracking (PageView/ViewContent/InitiateCheckout)
# injected in app/layout.tsx. Public by design (ships in every page's HTML), so it's
# safe to set directly. Find/create it in Meta Events Manager -> Datasets.
NEXT_PUBLIC_META_PIXEL_ID="xxx"

# Meta Conversions API — server-side Purchase event only (lib/templates/meta-capi.ts),
# fired from the Cashfree webhook and checkout/verify once payment is confirmed.
# Until this is set, sendPurchaseEvent() safely no-ops. Get it from Events Manager ->
# Datasets -> <your pixel> -> Settings -> Conversions API -> Set up direct integration
# -> Generate access token. This is a permanent, sensitive token — never commit it.
META_CONVERSIONS_API_ACCESS_TOKEN="xxx"

# Optional — set this to a Test Events code (Events Manager -> Test events) while
# verifying the integration; server events tagged with it show up live in that tab
# without polluting real ad-optimization data. Remove/unset once verified.
META_TEST_EVENT_CODE="xxx"
